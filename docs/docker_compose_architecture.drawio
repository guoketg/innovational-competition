        <mxCell id="docker" value="Docker Compose 一键编排 — 2 个服务 · 单网络 student-net · named volume 持久化" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#90A4AE;fillColor=#F5F7FA;verticalAlign=top;align=center;fontColor=#546E7A;fontStyle=1;fontSize=12;spacingTop=8;" vertex="1" parent="1">
