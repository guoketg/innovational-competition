        </mxCell>

        <!-- ═══════ 关键机制标注 ═══════ -->
        <mxCell id="note-order" value="启动顺序：student-frontend depends_on student-backend" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#D81B60;" vertex="1" parent="1">
