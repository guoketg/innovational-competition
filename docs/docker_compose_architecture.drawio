        </mxCell>

        <!-- ═══════ 前端容器 ═══════ -->
        <mxCell id="stu-fe" value="student-frontend（Nginx :80）&#xa;容器名 ai-learning-frontend · mem_limit 256m&#xa;Vue3 + Element Plus 构建产物 · SPA 路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════ 后端容器 ═══════ -->
        <mxCell id="stu-be" value="student-backend（FastAPI :8001→8000）&#xa;容器名 ai-learning-backend · mem_limit 1536m&#xa;编程实验室 · 能力验证 · RAG · 导师 SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="320" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════ 卷 ═══════ -->
