        </mxCell>

        <!-- ═══════ 网络：student-net ═══════ -->
        <mxCell id="net1" value="student-net（bridge）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#43A047;fillColor=#E8F5E9;verticalAlign=top;align=center;fontColor=#2E7D32;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
